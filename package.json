{
  "name": "dsh-pet-mobile",
  "version": "0.2.8",
  "description": "dsh-pet 的手机端：安卓透明悬浮窗养同一只宠物，动作/气泡/显示位置/尺寸与页面那只双向同步，并可把桌面输入的话送进 DSH 会话。",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib/",
    "assets/",
    "scripts/",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-pet",
    "desktop-pet",
    "android",
    "overlay",
    "悬浮窗",
    "桌宠"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.2": "compatible"
      }
    }
  },
  "peerDependencies": {
    "dsh-pet": ">=0.3.0"
  },
  "peerDependenciesMeta": {
    "dsh-pet": {
      "optional": true
    }
  }
}